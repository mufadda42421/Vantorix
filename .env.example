# ─────────────────────────────────────────────────────────────
# Vantorix — environment configuration
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# --- Contact form delivery (required for /api/inquiry to send email) ---
# Gmail example: enable 2FA on the account, then create an "App Password"
# (Google Account → Security → App passwords) and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jaorawalamufaddal7@gmail.com
SMTP_PASS=your_app_password_here

# Where enquiries should land (defaults to the site email if unset)
INQUIRY_TO_EMAIL=jaorawalamufaddal7@gmail.com

# --- Canonical site URL (used for OpenGraph, sitemap, robots) ---
# Also update `url` in lib/site.ts to match your deployed domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ─────────────────────────────────────────────────────────────
# Admin dashboard (/admin) — NOT included yet.
# The dashboard intentionally ships with no backend until you add:
#   - Auth.js (next-auth), Clerk, or Supabase Auth  (authentication)
#   - PostgreSQL via Supabase / Neon / Railway       (persistence)
#   - middleware.ts gating /admin and /api/admin/*   (protection)
# Never commit real credentials. See app/admin/page.tsx for the checklist.
# ─────────────────────────────────────────────────────────────
